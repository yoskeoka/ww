{
  "fixture_profile": {
    "repos": 6,
    "worktrees_per_repo": 5,
    "cleanable_worktrees_per_repo": 1
  },
  "benchmark_command": [
    "env",
    "WW_PERF_REPOS=6",
    "WW_PERF_WORKTREES_PER_REPO=5",
    "WW_PERF_CLEANABLE_WORKTREES_PER_REPO=1",
    "go",
    "test",
    "-run",
    "^$",
    "-bench",
    "^BenchmarkWorkspace(List|CleanDryRun)$",
    "-benchtime=1x",
    "./cmd/ww"
  ],
  "repetitions": 3,
  "benchmarks": {
    "BenchmarkWorkspaceList": {
      "max_ms_per_op": 400
    },
    "BenchmarkWorkspaceCleanDryRun": {
      "max_ms_per_op": 420
    }
  }
}
